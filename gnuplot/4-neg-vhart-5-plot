set term pngcairo size 1200,1200 enhanced font 'Arial,28'

set lmargin 14
set rmargin 4
set bmargin 6
set tmargin 3

set output "vhart-neg.PNG"

# Bingkai hitam
set border lt 1 lw 5 lc rgb 'black'

# Legend di kanan atas
set key top left
set key samplen 0.6
set key font "Arial,35"
#set key spacing 1.2
#set key textcolor rgb "black"

set zeroaxis

# Ticks
set ytics 0.4 out nomirror
set mytics 1
set format y "%.1f"

set xtics 10 out nomirror
set mxtics 1

unset y2tics
unset my2tics

set ytics font "Arial,50"
set xtics font "Arial,50"

set ylabel "{/Symbol D}V_{H} (eV)" font ("Arial,55") offset -3,0
set xlabel "x (Å)" font ("Arial,55")  offset 0,-1

set yrange [-0.8:0.8]
set xrange [0:40]

set xzeroaxis lt 0 lw 1.5 lc rgb 'black'

plot \
    "vh.txt" using 1:6 with lines lw 3.0 lc rgb "#C4E2B5" title "-0.0005e", \
    ""       using 1:5 with lines lw 3.0 lc rgb "#A6D18A" title "-0.0010e", \
    ""       using 1:4 with lines lw 3.0 lc rgb "#80B95B" title "-0.0015e", \
    ""       using 1:3 with lines lw 3.0 lc rgb "#5D963C" title "-0.0020e", \
    ""       using 1:2 with lines lw 3.0 lc rgb "#477B2C" title "-0.0025e", \
    "line.txt" using 1:2 with lines lw 3.0 lc rgb "#E0E0E0" dt 2 title "", \
    "line.txt" using 3:4 with lines lw 3.0 lc rgb "#E0E0E0" dt 2 title ""


unset output

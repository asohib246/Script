set term pngcairo size 1200,1200 enhanced font 'Arial,28'

set lmargin 14
set rmargin 4
set bmargin 6
set tmargin 3

set output "q-vs-v.PNG"

# Bingkai hitam
set border lt 1 lw 5 lc rgb 'black'

# Legend di kanan atas
set key top left
set key samplen 0.6
set key font "Arial,35"
#set key spacing 1.2
#set key textcolor rgb "black"

set zeroaxis

# Ticks
set ytics 0.5 out nomirror
set mytics 1
set format y "%.1f"

set xtics 0.4 out nomirror
set mxtics 1

unset y2tics
unset my2tics

set ytics font "Arial,50"
set xtics font "Arial,50"

set ylabel "{Q ({/Symbol m}C/cm^2)" font ("Arial,55") offset -3,0
set xlabel "V (volt)" font ("Arial,55")  offset 0,-1

set yrange [-1:1]
set xrange [-0.8:0.8]

set xzeroaxis lt 0 lw 1.5 lc rgb 'black'

plot \
	"ct.txt" using 3:2 with linespoints lw 3.0 lc rgb "blue" \
    		pt 6 ps 0.8 title "d = 10.07 Å", \
	#"ct.txt" using 2:5 with lines lw 3.0 dt 3 lc rgb "black" title "C_{geo}", \



unset output

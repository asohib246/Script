#!/bin/bash

# Loop untuk gr-vhart.txt
for i in {0..48}
do
    input="./$i/gr-vhart.txt"
    output="./$i/gr-vhart-f.txt"

    if [ ! -f "$input" ]; then
        echo "File tidak ditemukan: $input"
        continue
    fi

    awk '
    NF==3 {
        key = $2 " " $3
        if (!(key in seen)) {
            seen[key]=1
            print
        }
    }
    ' "$input" > "$output"

    echo "Selesai memproses folder $i, hasil disimpan di $output"
done


